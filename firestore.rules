rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile document: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing forbidden

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == userId
        && incoming().email is string
        && incoming().email.size() <= 256;

      allow update: if isOwner(userId)
        && incoming().userId == userId;

      allow delete: if isOwner(userId);

      // User study progress subcollection: /users/{userId}/progress/{progressId}
      match /progress/{progressId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(progressId)
          && incoming().userId == userId;

        allow update: if isOwner(userId)
          && incoming().userId == userId;

        allow delete: if isOwner(userId);
      }
    }

    // Community anonymized metrics for registered students
    match /communityMetrics/{metricId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(metricId)
        && incoming().userId == request.auth.uid
        && metricId == request.auth.uid
        && incoming().objective is string
        && incoming().objective.size() <= 200;

      allow update: if isSignedIn()
        && isValidId(metricId)
        && incoming().userId == request.auth.uid
        && metricId == request.auth.uid;

      allow delete: if isSignedIn()
        && metricId == request.auth.uid;
    }
  }
}
